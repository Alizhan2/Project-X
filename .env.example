# LOCAL DEVELOPMENT template. Copy to .env and adjust. Never commit .env. Hosting uses .env.production.example.
DOEDU_ENV=development
DOEDU_LAUNCH_MODE=development
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_DB=doedu
POSTGRES_USER=doedu
# Dev-only placeholder; set your own.
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
RESERVATION_MINUTES=10
# Set true only behind HTTPS (enables redirect + HSTS)
DJANGO_SECURE_SSL=false
