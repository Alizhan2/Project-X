# Template for the HOSTED environment. Copy to .env.production (never commit it) and fill in real values from your
# platform's secret store. Every variable is documented in docs/configuration.md.
DOEDU_ENV=production
DOEDU_LAUNCH_MODE=demo                    # demo = synthetic data + simulated payments. "commercial" refuses to start.
DOEDU_RELEASE=                            # set by the pipeline (git tag/sha); shown in the UI footer and /api/config/
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=                        # >= 50 random chars: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_ALLOWED_HOSTS=demo.example.org     # explicit host names only
DJANGO_CSRF_TRUSTED_ORIGINS=https://demo.example.org
DJANGO_SECURE_SSL=true                    # required in production: HTTPS redirect + HSTS (see docs/deployment.md rollout)
DOEDU_HSTS_SECONDS=3600                   # start at 1 hour; raise only after verifying HTTPS everywhere
DOEDU_TRUSTED_PROXIES=1                   # number of proxies in front of the app (for correct client IPs / rate limits)
GUNICORN_FORWARDED_ALLOW_IPS=*            # container is only reachable through the proxy (see compose network)
REGISTRATION_ENABLED=true                 # no e-mail verification/reset exists yet: see docs/security.md before enabling publicly
METRICS_TOKEN=                            # random token for /api/ops/metrics; empty disables the endpoint

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=doedu
POSTGRES_USER=doedu_app                   # runtime role: DML only
POSTGRES_PASSWORD=                        # app role password
MIGRATE_POSTGRES_USER=doedu_migrator      # used only by the one-shot migrate job
MIGRATE_POSTGRES_PASSWORD=
POSTGRES_ADMIN_USER=doedu_admin           # bootstrap superuser of the database container: not used by the application
POSTGRES_ADMIN_PASSWORD=

DEMO_SCHEDULE_DAYS=14                     # worker keeps the synthetic timetable 14 days ahead (additive; no accounts are created)
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_HOURS=24
